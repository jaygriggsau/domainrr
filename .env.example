# --- Database ---
# SQLite for local development. Swap the provider/url in prisma/schema.prisma
# for Postgres in production.
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Secret used to sign session JWTs. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# --- name.com reseller API ---
# Sandbox/dev: https://api.dev.name.com   Production: https://api.name.com
NAMECOM_API_URL="https://api.dev.name.com"
# In the dev environment your username is your name.com username with "-test"
# appended (e.g. "myuser-test"). Use the plain username in production.
NAMECOM_USERNAME="your-username-test"
NAMECOM_TOKEN="your-api-token"
